model MenuItem {
  id         String          @id @default(cuid())
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  stationId  String?
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  courseId   String?
  course     KitchenCourse?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  name        String
  sku         String?
  // HSN for goods, SAC for services. Snapshotted onto each order line.
  hsnCode     String?
  description String?
  imageUrl    String?

  price          Decimal // tax-inclusive selling price (see nodedr-pos GST lesson in ARCHITECTURE.md)
  taxRatePercent Decimal  @default(0)
  costPrice      Decimal?

  prepTimeMinutes Int?
  calories        Int?
  isVeg           Boolean    @default(true)
  isVegan         Boolean    @default(false)
  isJain          Boolean    @default(false)
  isHalal         Boolean    @default(false)
  isGlutenFree    Boolean    @default(false)
  spiceLevel      String @default("NONE")
  allergens       Json @default("[]")

  availableFrom String? // "HH:mm" — availability window
  availableTo   String?
  isSeasonal    Boolean   @default(false)
  seasonStart   DateTime?
  seasonEnd     DateTime?

  barcode      String?
  // When set, `price` is per kilogram and the till must send a weight.
  soldByWeight Boolean @default(false)
  isActive Boolean @default(true)
  isCombo  Boolean @default(false)

  inventoryTracking    String @default("NONE")
  stockIngredientId    String?
  stockIngredient      Ingredient?       @relation("DirectStockItem", fields: [stockIngredientId], references: [id], onDelete: SetNull)
  stockQuantityPerSale Decimal           @default(1)

  // Price of a half portion; null = item has no portion picker. `price` is the full portion.
  halfPrice Decimal?
  servings      Int      @default(1)
  yieldQuantity Decimal?
  yieldUnit     String?
  instructions  String?
  portionStep   Decimal  @default(1)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modifierGroups  MenuItemModifierGroup[]
  orderItems      OrderItem[]
  comboComponents ComboComponent[]        @relation("ComboParent")
  usedInCombos    ComboComponent[]        @relation("ComboChild")
  recipeLines         RecipeIngredient[]
  demandForecastLines DemandForecastLine[]
  sizes           MenuItemSize[]
  channelPrices   MenuItemChannelPrice[]
  menuSets        MenuSetItem[]
  recipeRevisions RecipeRevision[]
  brandItem       BrandMenuItem? @relation(fields: [brandItemId], references: [id], onDelete: SetNull)
  brandItemId     String?

  @@unique([branchId, barcode])
  @@index([brandItemId])
  @@index([branchId, categoryId])
  @@map("menu_items")
}

