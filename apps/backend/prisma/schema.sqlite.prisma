// ---------------------------------------------------------------------------
// Customers (minimal Phase 1 shape — full CRM lands Phase 3)
// ---------------------------------------------------------------------------

model Customer {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String?
  phone       String?
  email       String?
  emailLookup String?
  address     String?
  birthday    DateTime?
  anniversary DateTime?
  allergies   String?
  notes       String?

  loyaltyPoints   Int     @default(0)
  // Opted out of marketing messages; excluded from every campaign audience.
  marketingOptOut Boolean @default(false)
  walletBalance   Decimal @default(0) // store credit
  cashbackBalance Decimal @default(0)
  houseAccounts   HouseAccount[]

  rfmRecency    Int?
  rfmFrequency  Int?
  rfmMonetary   Int?
  rfmScore      String?
  rfmSegment    String?
  clvEstimate   Decimal   @default(0)
  rfmComputedAt DateTime?

  createdAt DateTime   @default(now())
  orders    Order[]
