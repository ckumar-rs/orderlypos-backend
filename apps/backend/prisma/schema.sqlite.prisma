// ---------------------------------------------------------------------------
// Orders / KOT / Payments
// ---------------------------------------------------------------------------





// Where an order/reservation came from: staff at the POS/phone (STAFF) or a
// guest through the website / QR (ONLINE). Drives the Online vs Offline
// split in the dashboard. Separate from String (dine-in/takeaway/...),
// which says how it is fulfilled.


// Accept/reject gate for online orders. NOT_REQUIRED = staff-entered or
// auto-confirmed-by-QR orders that never wait; PENDING = waiting for staff to
// accept (no kitchen ticket is printed yet); ACCEPTED/REJECTED = decided.
// Why an order ended up CANCELLED, so a kitchen rejection or a declined online
// order is never confused with staff or the guest withdrawing it.


// How the manual discount on a bill was entered.




// Delivery lifecycle, separate from String (billing) and String
// (kitchen). Null on non-delivery orders.


// Inbound delivery-platform orders (Zomato, Swiggy). This app does not call
// those platforms; a relay posts their orders to a branch webhook.


model Order {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orderNumber String // human-readable, sequential per branch per day
  type        String        @default("DINE_IN")
  status      String      @default("OPEN")
  channel     String     @default("STAFF")
  acceptance  String @default("NOT_REQUIRED")

  tableId    String?
  table      Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  salesChannelId String?
  salesChannel   SalesChannel? @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  guestCount Int?
  // Name typed in by the guest on the QR self-order flow — no account, so
  // this is the only identity captured for that order.
  guestName  String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  subtotal              Decimal @default(0)
  discountAmount        Decimal @default(0)
  taxAmount             Decimal @default(0) // informational breakup only — see ARCHITECTURE.md inclusive-pricing note
  tipAmount             Decimal @default(0)
  loyaltyPointsRedeemed Int     @default(0)
  loyaltyDiscountAmount Decimal @default(0)
  totalAmount           Decimal @default(0)

  notes         String?
  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelSource  String?

  // Who accepted an incoming order and when (acceptance gate only).
  acceptedAt   DateTime?
  acceptedById String?

  // The manual discount as the cashier entered it, kept next to the computed
  // discountAmount so a bill can show both the percentage and the amount.
  discountType  String?
  discountValue Decimal?

  // Client-generated idempotency key for public/unauthenticated order
  // submits (kiosk). A retry after a dropped connection carries the same
  // key and gets the original order back instead of creating a second one.
  clientRequestId String?

  // Set together when the order arrived from a delivery platform. The pair
  // is unique per branch so a retried webhook returns the original ticket.
  foodPlatform    String?
  externalOrderId String?
  // Last status this server pretended to send to Zomato or Swiggy.
  demoPlatformStatus String?

  // Delivery (Phase 5). deliveryFee is added on top of the item total at
  // checkout; the zone's fee is snapshotted so later zone edits never
  // rewrite history.
  deliveryZoneId  String?
  deliveryZone    DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryFee     Decimal         @default(0)
  deliveryAddress String?
  deliveryPincode String?
  deliveryPhone   String?
  deliveryStatus  String?
  driverId        String?
  driver          User?           @relation("OrderDriver", fields: [driverId], references: [id], onDelete: SetNull)
  deliveryEtaAt   DateTime?
  deliveredAt     DateTime?
  // Last point the assigned driver chose to share from their own device.
  driverLat        Decimal?
  driverLng        Decimal?
  driverLocationAt DateTime?
  trackingToken    String?   @unique
  driverPings      DriverPing[]
  paymentIntents   PaymentIntent[]
  fleetJobs        FleetJob[]
  partyName       String?
  curbside        Boolean  @default(false)
  vehicleNote     String?
  source          String?
  // Scheduled / pre-order: the kitchen should not start before this time.
  scheduledFor    DateTime?

  // Marketing (Phase 7): what discount source was applied at checkout.
  couponCode    String?
  promotionName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  billedAt  DateTime?

  items               OrderItem[]
  kots                Kot[]
  payments            Payment[]
  giftCardRedemptions GiftCardRedemption[]
  refunds             Refund[]

  @@unique([branchId, orderNumber])
  @@unique([branchId, clientRequestId])
  @@unique([branchId, foodPlatform, externalOrderId])
  @@index([branchId, status])
  @@index([branchId, deliveryStatus])
  @@map("orders")
}

// One webhook secret per platform per branch. secretHash is what the public
// intake endpoint looks up; secretSealed is so Settings can show it again.
model FoodPlatformIntake {
  id           String       @id @default(cuid())
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  platform     String
  enabled      Boolean      @default(false)
  outletId     String?
  secretHash   String       @unique
  secretSealed String
  apiBaseUrl   String?
  apiKeySealed String?
  storeOpen    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([branchId, platform])
  @@map("food_platform_intakes")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  // Snapshotted at order time so later menu edits never rewrite history
  // (same discipline as nodedr-pos snapshotting name/taxRate/unit onto InvoiceItem).
  nameSnapshot      String
  unitPriceSnapshot Decimal
  taxRateSnapshot   Decimal

  quantity      Int     @default(1)
  portionFactor Decimal @default(1)
  // Set when the dish is sold by weight. `quantity` stays 1; the name
  // snapshot includes the kilograms and lineTotal is price × weight.
  weightKg    Decimal?
  lineTotal   Decimal
  kitchenNote String?
  sizeName    String?
  status      String @default("NEW")

  modifiers    OrderItemModifier[]
  kotItems     KotItem[]
  stockReturns OrderItemStockReturn[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  String
  modifier    Modifier  @relation(fields: [modifierId], references: [id])

  nameSnapshot     String
  priceAdjSnapshot Decimal

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Kitchen Order Tickets
// ---------------------------------------------------------------------------





model Kot {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId String?
  station   KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  courseId  String?
  course    KitchenCourse?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  ticketNumber    String
  status          String @default("NEW")
  held            Boolean @default(false)
  firedAt         DateTime?
  expoAssembledAt DateTime?
  isPriority      Boolean @default(false)
  printedCount   Int       @default(0)
  printedAt      DateTime?
  lastPrintError String?

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  readyAt    DateTime?
  servedAt   DateTime?

  // Who moved the ticket and, for a rejection, when and why.
  acceptedById String?
  rejectedAt   DateTime?
  rejectedById String?
  rejectReason String?

  items KotItem[]

  @@index([orderId])
  @@index([stationId, status])
  @@map("kots")
}

model KotItem {
  id          String    @id @default(cuid())
  kotId       String
  kot         Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  status      String @default("NEW")
  delayReason String?
  wasDelayed  Boolean @default(false)

  @@index([kotId])
  @@map("kot_items")
}

