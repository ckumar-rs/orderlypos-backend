// Monthly spending budget for one expense category (category matches
// Expense.category, case-insensitively, when budget-vs-actual is computed).
model Budget {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  month    String // "YYYY-MM"
  category String
  amount   Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, month, category])
  @@map("budgets")
}



// One line of an imported bank statement. amount is signed: + money in,
// - money out. Outgoing lines are matched against recorded Expenses.
model BankTransaction {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  postedOn    DateTime
