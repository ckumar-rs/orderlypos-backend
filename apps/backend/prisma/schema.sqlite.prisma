  reference   String       @default("") // "" not null, so the unique key dedupes re-imports
  amount      Decimal
  status      String @default("UNMATCHED")
  expenseId   String?
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@unique([branchId, postedOn, description, amount, reference])
  @@index([branchId, postedOn])
  @@map("bank_transactions")
}

