// Nodedr OrderRestro — Phase 0/1 core schema.
// See ARCHITECTURE.md for why PostgreSQL is the primary target and how
// multi-branch/single-location both map onto the same schema (a branch is
// just a Branch row, not a different deployment mode).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / Branch
// ---------------------------------------------------------------------------

// A branch's tax regime picks sensible defaults (display label, whether the
// receipt splits into CGST/SGST, and the usual INCLUSIVE/EXCLUSIVE mode) —
// see taxRegimes.ts. CUSTOM means every one of those is taken from the
// branch's own taxLabel/taxMode instead of the preset.


// Whether MenuItem.price already has tax baked in (the nodedr-pos GST
// lesson — India/EU/Spain all display tax-inclusive menu prices by
// convention/regulation) or is a pre-tax price the checkout adds tax on
// top of (the US norm). See pricing.ts's toEffectiveInclusiveUnitPrice —
// this is the ONLY place the mode changes the pricing math; everything
// downstream of that (OrderItem.lineTotal, receipts, refunds) keeps
// working off an already-inclusive amount exactly as before.


model Restaurant {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  // The restaurant's own branding, shown in the app shell (sidebar header,
  // login screen) in place of the Nodedr OrderRestro product mark — this is
  // white-label self-hosted software, so the operator's brand should lead;
  // the product name stays as a small credit line instead (see BrandFooter).
  logoUrl   String?
  currency  String  @default("INR")
  timezone  String  @default("Asia/Kolkata")

  // UPI payee for the dynamic QR shown at checkout and on the customer
  // display (NPCI deep link, see apps/web/lib/upi.ts). Optional: when unset
  // the UPI method still works, it just shows no QR.
  upiVpa       String?
  upiPayeeName String?
  receiptEmail String?

  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPasswordSealed String?
  smtpFrom           String?
  smtpSecure         Boolean @default(true)

  tallyEnabled     Boolean @default(false)
  tallyCompanyName String?
  tallyHost        String?
  tallyPort        Int?
  tallyUseHttps    Boolean @default(false)

  syncEnabled       Boolean  @default(false)
  syncHqUrl         String?
  syncHqTokenSealed String?
  syncIntervalSec   Int      @default(60)
  syncLastAt        DateTime?
  syncLastError     String?

  payCash  Boolean @default(false)
  payCard  Boolean @default(false)
  payUpi   Boolean @default(true)
  payOther Boolean @default(false)

  receiptWhatsApp     Boolean @default(true)
  receiptEmailEnabled Boolean @default(true)
  receiptPrint        Boolean @default(true)

  employeeDiscountPercent Decimal @default(0)
  reservationMessage      String?

  waCloudEnabled           Boolean @default(false)
  waCloudBaseUrl           String?
  waCloudPhoneNumberId     String?
  waCloudAccessTokenSealed String?
  waCloudTemplateName      String?
  waCloudTemplateLang      String?

  smsEnabled         Boolean @default(false)
  smsProvider        String?
  smsBaseUrl         String?
  smsApiKeySealed    String?
  smsApiSecretSealed String?
  smsSenderId        String?
  smsCountryPrefix   String?

  clvHorizonMonths Int     @default(12)
  clvMarginPercent Decimal @default(100)

  aiEnabled        Boolean @default(false)
  aiProvider       String?
  aiBaseUrl        String?
  aiModel          String?
  aiTokenSealed    String?
  aiHistoryDays    Int     @default(28)
  aiHorizonDays    Int     @default(7)
  aiLeadTimeDays   Int?
  weatherBaseUrl   String?
  weatherApiKeySealed String?
  targetFoodCostPercent Decimal @default(30)
  noShowFee             Decimal @default(0)
  approvalDiscountAbove Decimal?
  approvalForVoid       Boolean @default(false)
  approvalForRefund     Boolean @default(false)
  franchisePriceLock Boolean @default(false)
  ipAllowList        String  @default("")
  requireDevice      Boolean @default(false)

  // Local demo stand-ins for a bank, WhatsApp, a supplier order, and a
  // delivery-platform status. Off unless the owner turns it on. Nothing
  // here contacts an outside service.
  demoMode Boolean @default(false)

  // Loyalty program config — previously hardcoded constants in
  // OrdersService, now per-restaurant and settings-editable. Point value
  // is the currency amount 1 redeemed point is worth; earn rate is how
  // many currency units of net spend earn 1 point (floor division).
  loyaltyPointValue      Decimal @default(1)
  loyaltyEarnPerCurrency Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches           Branch[]
  roles              Role[]
  users              User[]
  integrationApiKeys IntegrationApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  tallyLedgers       TallyLedger[]
  tallyPosts         TallyPost[]
  hqSyncEvents       HqSyncEvent[]
  rfmLabels          RfmLabel[]
  outboundMessages   OutboundMessage[]
  messageOptOuts     MessageOptOut[]
  paymentGateways    PaymentGateway[]
  brands             Brand[]
  exchangeRates      ExchangeRate[]
  installedApps      InstalledApp[]

  @@map("restaurants")
}

model TallyLedger {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sourceKey    String
  ledgerName   String

  @@unique([restaurantId, sourceKey])
  @@map("tally_ledgers")
}

model Branch {
  id                String             @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  attendance        Attendance[]
  deliveryZones     DeliveryZone[]
  shifts            Shift[]
  leaveRequests     LeaveRequest[]
  payrollRuns       PayrollRun[]
  expenses          Expense[]
  budgets           Budget[]
  bankTransactions  BankTransaction[]
  reportSchedules   ReportSchedule[]
  cashClosings      CashClosing[]
  pettyCashEntries  PettyCashEntry[]
  coupons           Coupon[]
  promotions        Promotion[]
  campaigns         Campaign[]
  equipment         Equipment[]
  documents         Document[]
  verifactuSettings VerifactuSettings?
  verifactuRecords  VerifactuRecord[]
  posDevices        PosDevice[]
  customFields      CustomField[]
  savedReports      SavedReport[]
  automationRules   AutomationRule[]
  automationTasks   AutomationTask[]
  offlineConflicts  OfflineConflict[]
  replayReceipts    ReplayReceipt[]

  name      String
  address   String?
  phone     String?
  gstNumber String?

  // Multi-region tax config (2026-09-27). country is an ISO 3166-1 alpha-2
  // code driving default currency/locale suggestions in the UI; it does not
  // itself change pricing math. taxRegime picks the preset (label, mode,
  // CGST/SGST split) from taxRegimes.ts; taxMode/taxLabel/taxId override
  // that preset when set (taxMode is always non-null — it defaults to the
  // regime's own default and is what pricing.ts actually reads). taxId is
  // the generic registration number (VAT No. / EIN / NIF-CIF); gstNumber
  // is kept as the India-specific field pre-existing installs already
  // populated and remains the fallback when taxRegime is INDIA_GST and
  // taxId is empty.
  country   String    @default("IN")
  taxRegime String @default("INDIA_GST")
  taxMode   String   @default("INCLUSIVE")
  taxLabel  String?
  taxId     String?

  // Online order / table-booking handling: false = staff must accept each
  // one from the dashboard; true = accepted automatically on arrival.
  autoConfirmOrders       Boolean @default(false)
  autoConfirmReservations Boolean @default(false)
  onlineOrdersPaused      Boolean @default(false)

  // Self-service kiosk (2026-10-17). kioskToken is the opaque, unguessable
  // credential in the public /kiosk/<token> URL (same idea as
  // Table.qrToken); null = kiosk switched off for this branch. The two
  // flags choose which "eat here / take away" buttons the start screen
  // offers; if only one is on the choice step is skipped.
  kioskToken           String? @unique
  kioskDineInEnabled   Boolean @default(true)
  kioskTakeawayEnabled Boolean @default(true)

  // Direct ESC/POS thermal printing. Columns null = derived from paper width
  // (58 mm -> 32, 80 mm -> 48); set it for printers with a narrower head.
  printerPaperWidthMm Int     @default(80)
  printerCodepage     String  @default("CP858")
  printerColumns      Int?
  // "USB" = printer attached to the machine running the backend; "NETWORK" =
  // raw ESC/POS over TCP to printerHost:printerPort (usually 9100).
  printerConnection   String  @default("USB")
  printerHost         String?
  printerPort         Int     @default(9100)

  isActive  Boolean  @default(true)
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floors          Floor[]
  whatsappIntake  WhatsAppIntake?
  tillSessions    TillSession[]
  approvalRequests ApprovalRequest[]
  users           UserBranch[]
  menuItems       MenuItem[]
  categories      MenuCategory[]
  modifierGroups  ModifierGroup[]
  stations        KitchenStation[]
  kitchenCourses  KitchenCourse[]
  orders          Order[]
  customers       Customer[]
  loyaltyRule     LoyaltyRule?
  rewards         Reward[]
  employeeDiscounts EmployeeDiscount[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  giftCards       GiftCard[]
  ingredients      Ingredient[]
  unitConversions  UnitConversion[]
  inventoryAlerts  InventoryAlert[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockBatches    StockBatch[]
  stockMovements  StockMovement[]
  wasteLogs       WasteLog[]
  stockCounts     StockCount[]
  prepRecipes     PrepRecipe[]
  prepBatches     PrepBatch[]
  demandForecasts DemandForecast[]

  purchaseRequests   PurchaseRequest[]
  supplierQuotations SupplierQuotation[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]
  notifications      Notification[]
  integrationApiKeys IntegrationApiKey[]
  foodPlatformIntakes FoodPlatformIntake[]
  edcTerminals        EdcTerminal[]
  houseAccounts       HouseAccount[]
  fleetAccounts       FleetAccount[]
  salesChannels       SalesChannel[]
  menuSets            MenuSet[]
  menuPriceRules      MenuPriceRule[]
  ledgerAccounts      LedgerAccount[]
  journalVouchers     JournalVoucher[]
  ledgerAccountMaps   LedgerAccountMap[]
  syncOutbox          SyncOutbox[]
  tallyPosts          TallyPost[]

  @@index([restaurantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

// The fixed 11-role template used only at seed/signup time to bootstrap a
// new restaurant's default roles now lives as `STAFF_ROLES` in
// packages/types/src/permissions.ts (TS const array), not here. `Role.name`
// below is a plain String — an Owner can create custom roles with any name
// beyond that seeded set (e.g. "Display", "Host", "Valet").

model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "orders.create", "menu.manage"
  label    String
  category String // grouping for the settings UI, e.g. "Orders", "Inventory"

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  label     String
  isSystem  Boolean  @default(true) // seeded default role vs. custom role
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       User[]
  employeeDiscounts EmployeeDiscount[]

  @@unique([restaurantId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  name                    String
  email                   String?
  phone                   String?
  passwordHash            String
  pinHash                 String? // quick-switch PIN login on a shared terminal
  isActive                Boolean  @default(true)
  twoFactorSecret         String? // AES-GCM sealed TOTP secret (see auth/totp.ts)
  twoFactorEnabled        Boolean  @default(false)
  twoFactorRecoveryHashes Json @default("[]") // bcrypt hashes of unused one-time recovery codes
  twoFactorLastStep       Int? // last accepted TOTP step: a code works once

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      UserBranch[]
  waiterTables  Table[]        @relation("TableWaiter")
  ordersCreated Order[]        @relation("OrderCreatedBy")
  auditLogs     AuditLog[]
  refundsIssued Refund[]
  notifications Notification[] @relation("NotificationRecipient")
  webauthnCredentials WebAuthnCredential[]

  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  goodsReceiptsReceived GoodsReceipt[]  @relation("GoodsReceiptReceivedBy")
  stockMovementsCreated StockMovement[] @relation("StockMovementCreatedBy")
  wasteLogsCreated      WasteLog[]      @relation("WasteLogCreatedBy")
  stockCountsCounted    StockCount[]    @relation("StockCountCountedBy")
  prepBatchesProduced   PrepBatch[]     @relation("PrepBatchProducedBy")
  demandForecastsGenerated DemandForecast[] @relation("DemandForecastGeneratedBy")
  houseAccountEntries      HouseAccountEntry[] @relation("HouseAccountEntryBy")
  tillSessionsOpened       TillSession[] @relation("TillOpenedBy")
  tillSessionsClosed       TillSession[] @relation("TillClosedBy")
  approvalRequests         ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalDecisions        ApprovalRequest[] @relation("ApprovalDecidedBy")
  attendance            Attendance[]
  deliveriesDriven      Order[]         @relation("OrderDriver")
  shifts                Shift[]
  leaveRequests         LeaveRequest[]  @relation("LeaveRequester")
  leaveDecided          LeaveRequest[]  @relation("LeaveDecider")
  payProfile            StaffPay?
  payrollLines          PayrollLine[]
  expensesCreated       Expense[]
  expensesDecided       Expense[]        @relation("ExpenseDecider")
  pettyCashEntries      PettyCashEntry[]

  purchaseRequestsRequested PurchaseRequest[]   @relation("PurchaseRequestRequestedBy")
  purchaseRequestsApproved  PurchaseRequest[]   @relation("PurchaseRequestApprovedBy")
  supplierQuotationsCreated SupplierQuotation[] @relation("SupplierQuotationCreatedBy")
  supplierInvoicesRecorded  SupplierInvoice[]   @relation("SupplierInvoiceRecordedBy")
  supplierPaymentsRecorded  SupplierPayment[]   @relation("SupplierPaymentRecordedBy")

  backupsTriggered Backup[] @relation("BackupTriggeredBy")

  staffApiKeys              StaffApiKey[]
  integrationApiKeysCreated IntegrationApiKey[] @relation("IntegrationApiKeyCreatedBy")
  employeeDiscounts         EmployeeDiscount[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// API keys — two distinct kinds, deliberately not one model. See
// docs/integrations-api.md for the full design rationale.
// ---------------------------------------------------------------------------

// A personal access token: resolves to its owning User exactly like a
// logged-in session would, so every existing permission check (PermissionsGuard,
// user.permissions) applies unchanged. Used by the MCP server (see src/mcp/)
// and any other programmatic client acting as that staff member.
model StaffApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  tokenHash  String    @unique
  lastFour   String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("staff_api_keys")
}

// A restaurant-issued credential for an EXTERNAL system (a partner
// website's own backend, an aggregator, a booking widget) — not tied to any
// staff member's identity or permissions. Carries its own explicit `scopes`
// and can be scoped to a single branch ("selected location") or the whole
// restaurant. Consumed by src/integrations/'s public REST API.
model IntegrationApiKey {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  tokenHash String   @unique
  lastFour  String
  scopes    Json

  createdById String
  createdBy   User   @relation("IntegrationApiKeyCreatedBy", fields: [createdById], references: [id])

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([restaurantId])
  @@index([branchId])
  @@map("integration_api_keys")
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

// In-app notifications (Phase 3 of the RBAC/audit/backup plan) — bell icon +
// sound/haptic in the dashboard topbar. Scoped by `branchId` only, not a
// denormalized `restaurantId`, matching the rest of the schema's convention
// (Order/Table/etc. derive restaurant via branch.restaurant rather than
// storing both). `recipientUserId` is nullable in the model (room for a
// future branch-wide broadcast row), but every current call site
// (NotificationsService.notifyByPermission/notifyUser) always creates one
// row per resolved recipient. `type` is free-form like AuditLog.action
// (e.g. "order.new", "order.ready") — not an enum, so new trigger types
// never need a migration.
model Notification {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  recipientUserId String?
  recipient       User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  type     String
  title    String
  body     String
  entity   String?
  entityId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([branchId, recipientUserId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Backup / restore (Phase 4 of the RBAC/audit/backup plan)
//
// Both models are deliberately instance-wide — no restaurantId/branchId —
// because a `pg_dump` of the shared Postgres instance covers every
// Restaurant row on this server, not one tenant, and the uploads directory
// (see UPLOADS_DIR / common/upload/image-upload.config.ts's `uploadsDir()`)
// is likewise a single shared volume. Ported from zulivio's proven
// BackupRecord/BackupConfig design (apps/backend/src/backup/) — see
// backup.service.ts for the full restore-safety reasoning.
// ---------------------------------------------------------------------------



model Backup {
  id     String       @id @default(cuid())
  status String @default("PENDING")

  // Int, not BigInt: BigInt doesn't JSON-serialize without extra plumbing
  // (JSON.stringify throws on it), and every real deployment target here
  // (self-hosted restaurant DB + uploads dir) stays well under 2GB. Revisit
  // if a real deployment's dump ever approaches that ceiling.
  sizeBytes    Int?
  s3KeyDb      String?
  s3KeyUploads String?
  sha256       String?

  // Null for scheduled/cron-triggered runs (see backup.service.ts's
  // @Cron job) — only manual triggers have an actor.
  triggeredById String?
  triggeredBy   User?   @relation("BackupTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  failureReason String?
  createdAt     DateTime  @default(now())
  verifiedAt    DateTime?

  @@index([status, createdAt])
  @@map("backups")
}

// Singleton row (id is always the literal "singleton") holding S3 backup
// credentials entered from Settings > Backup, so the app is self-contained
// without requiring env-var/CasaOS config editing. Plaintext at rest — same
// trust boundary as DATABASE_URL/JWT_SECRET already sitting in this app's
// env — and never returned by the API after being set (masked in reads).
model BackupConfig {
  id              String   @id @default("singleton")
  endpoint        String
  bucket          String
  accessKeyId     String
  secretAccessKey String
  region          String   @default("auto")
  intervalDays    Int      @default(3)
  retainCount     Int      @default(2)
  updatedById     String?
  updatedAt       DateTime @updatedAt

  @@map("backup_config")
}

// ---------------------------------------------------------------------------
// Floor & Table management
// ---------------------------------------------------------------------------



model Floor {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)
  gridSize  Float  @default(20)
  seating   String @default("INDOOR")

  tables Table[]

  @@index([branchId])
  @@map("floors")
}

model Table {
  id      String @id @default(cuid())
  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  number      String
  name        String?
  capacity    Int         @default(2)
  status      String @default("AVAILABLE")
  // When `status` last changed — set automatically by a Prisma middleware
  // (see PrismaService) on every write that includes a `status` field, not
  // hand-maintained per call site (status changes from many places: table
  // status dropdown, order creation/checkout, reservation arrival/cancel,
  // waitlist seating). Powers the "how long has this table been occupied/
  // reserved" timer on the floor view and POS table picker.
  statusSince DateTime    @default(now())

  // Floor designer layout — percentage-based so any canvas size renders consistently
  posX     Float   @default(0)
  posY     Float   @default(0)
  width    Float   @default(80)
  height   Float   @default(80)
  rotation Float   @default(0)
  shape    String  @default("square") // square | round | rect
  color    String?

  assignedWaiterId String?
  assignedWaiter   User?   @relation("TableWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)

  notes   String?
  qrToken String? @unique // opaque token embedded in the table's QR code (Phase 2+)

  orders          Order[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests TableRequest[]

  @@unique([floorId, number])
  @@index([floorId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Menu management
// ---------------------------------------------------------------------------

model MenuCategory {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)
  // false = still on the POS, but hidden from the QR/online ordering page and
  // from the Integration API that feeds the restaurant's own website.
  showOnWebsite Boolean @default(true)
  parentId      String?
  parent        MenuCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      MenuCategory[] @relation("CategoryTree")

  items      MenuItem[]
  promotions Promotion[]

  @@index([branchId])
  @@index([parentId])
  @@map("menu_categories")
}

model KitchenStation {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  printerName String?
  role        String @default("COOK")

  items MenuItem[]
  kots  Kot[]

  @@index([branchId])
  @@map("kitchen_stations")
}

model KitchenCourse {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  sortOrder     Int     @default(0)
  holdByDefault Boolean @default(false)

  items MenuItem[]
  kots  Kot[]

  @@index([branchId])
  @@map("kitchen_courses")
}



// ---------------------------------------------------------------------------
// Inventory & Store Management (Phase 4)
//
// Deliberate scope-cut vs. the full spec ("units + unit conversion"): each
// Ingredient has ONE base unit, used consistently for its recipe quantities,
// PO/GRN quantities, and stock. A real conversion engine (buy a 25kg bag,
// stock/recipe in kg) is deferred — see ROADMAP.md — rather than guessed at.
//
// Costing is weighted-average (WAC), recomputed on every GRN receipt:
// newCost = ((oldStock * oldCost) + (receivedQty * receivedCost)) /
// (oldStock + receivedQty). Ingredient.currentStock/costPerUnit are cached
// columns, but NEVER mutated with a DB `increment` — same float-drift lesson
// nodedr-pos learned the hard way (see its project memory): every mutation
// reads the current value, computes the new one in JS with round4, and
// `set`s it inside the same transaction as the StockMovement ledger row.
// StockMovement is the append-only source of truth; the cached columns are
// a read optimization that must always be derivable by summing it.
// ---------------------------------------------------------------------------



model Ingredient {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name         String
  sku          String?
  unit         String
  purchaseToBase Decimal @default(1)
  reorderLevel Decimal        @default(0)
  leadTimeDays Decimal?

  // Cached from the StockMovement ledger — see note above on why these are
  // safe (transactional read-then-set, never `increment`).
  currentStock Decimal @default(0)
  costPerUnit  Decimal @default(0) // weighted-average cost

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeLines        RecipeIngredient[]
  directMenuItems    MenuItem[]          @relation("DirectStockItem")
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockBatches       StockBatch[]
  stockMovements     StockMovement[]
  wasteLogs          WasteLog[]

  purchaseRequestItems   PurchaseRequestItem[]
  supplierQuotationItems SupplierQuotationItem[]
  stockCountLines        StockCountLine[]
  prepRecipesOut         PrepRecipe[]      @relation("PrepRecipeOutput")
  prepRecipeLines        PrepRecipeLine[]  @relation("PrepRecipeInput")
  prepBatches            PrepBatch[]
  prepBatchLines         PrepBatchLine[]
  demandForecastLines    DemandForecastLine[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("ingredients")
}

