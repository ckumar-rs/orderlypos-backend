}

model StockBatch {
  id           String     @id @default(cuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  goodsReceiptItemId String?           @unique
  goodsReceiptItem   GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)

  batchNumber       String
  quantityReceived  Decimal
  quantityRemaining Decimal
  unitCost          Decimal
  expiryDate        DateTime?
  receivedAt        DateTime  @default(now())

  stockMovements StockMovement[]
  wasteLogs      WasteLog[]

  @@index([branchId, ingredientId, receivedAt])
  @@map("stock_batches")
}



// How selling a menu item moves inventory.
//   NONE   - not stock-tracked; selling it never touches inventory.
//   RECIPE - deducts its RecipeIngredient lines per unit sold.
//   DIRECT - deducts stockQuantityPerSale of one stock item (stockIngredientId)
//            per unit sold, e.g. bottled drinks sold as-is; no fake recipe.


model StockMovement {
  id           String      @id @default(cuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  type     String
  quantity Decimal // signed: +in, -out
  note     String?
  // Set for order-driven movements (checkout consumption / return reversal).
  // Plain column, no FK: the ledger must outlive a deleted order.
  orderId  String?
  stockCountId String?
  stockCount   StockCount? @relation(fields: [stockCountId], references: [id], onDelete: SetNull)
  prepBatchId  String?
  prepBatch    PrepBatch?  @relation(fields: [prepBatchId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, ingredientId, createdAt])
  @@index([orderId])
  @@index([stockCountId])
  @@index([prepBatchId])
  @@map("stock_movements")
}



model WasteLog {
  id           String      @id @default(cuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  quantity        Decimal
  reason          String
  unitCostAtWaste Decimal
  notes           String?

  createdById String
  createdBy   User     @relation("WasteLogCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, ingredientId, createdAt])
  @@map("waste_logs")
}

model StockCount {
