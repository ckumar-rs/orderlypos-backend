  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  specialRequests String?
  deposit         Decimal?
  depositPaid     Boolean  @default(false)
  depositReference String?
  depositStatus   String   @default("NONE")
  depositMethod   String?
  feeCharged        Decimal  @default(0)
  feeChargeUrl      String?
  feeChargeRef      String?
  feeChargeStatus   String?
  feeChargeProvider String?
  status          String @default("RESERVED")
  channel         String      @default("STAFF")
  reminderSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, reservedAt])
  @@map("reservations")
}



model WaitlistEntry {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  customerName      String
  phone             String?
  partySize         Int
  quotedWaitMinutes Int?
  notes             String?
  status            String @default("WAITING")

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  seatedAt  DateTime?

  @@index([branchId, status])
  @@map("waitlist_entries")
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method          String
  amount          Decimal // applied to the bill (net of change)
  reference       String? // gateway/UPI txn ref
  gatewayProvider String?
  utr             String?
  // Cash actually handed over and the change given back, when the guest paid
  // more than was applied. Null on older payments and exact payments.
  tendered        Decimal?
  changeGiven     Decimal?
  createdById     String?
  // Client-generated key for one checkout attempt, so a retried or
  // double-tapped request records its payments once.
  clientRequestId String?
  createdAt       DateTime      @default(now())

  bankMatches BankTransaction[]

  @@unique([orderId, clientRequestId])
  @@index([orderId])
  @@index([utr])
  @@map("payments")
}

model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount      Decimal
  reason      String?
  method      String // how the refund was issued back to the guest
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  stockReturns OrderItemStockReturn[]

  @@index([orderId])
  @@map("refunds")
}

// Which sold units were physically returned (and so put back in stock) with a
// refund. A monetary refund alone never restores stock; rows here are the only
// thing that does, and they cap further returns at the quantity sold.
model OrderItemStockReturn {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
  @@index([refundId])
  @@map("order_item_stock_returns")
}

// ---------------------------------------------------------------------------
// Public site: download tracking
// ---------------------------------------------------------------------------

// One row per distribution channel (git-clone, install-script, docker,
// casaos, github, windows-msix, ...) — an aggregate counter, not a
// per-visitor event log. Deliberately stores no IP address, user agent, or
// any other visitor-identifying data: a raw click count needs none of that,
// and not collecting it in the first place is simpler and safer under the
// DPDP Act 2023 than collecting personal data and then having to justify
// retention/consent/erasure for it (see docs/COMPLIANCE-INDIA.md).
model DownloadStat {
  channel String @id
  count   Int    @default(0)

  @@map("download_stats")
}

// Staff clock-in/out (Phase 6). One open row (clockOutAt null) per user at a
// time — enforced in AttendanceService, not the DB, so a forgotten clock-out
// can be closed by a manager rather than blocking the next shift.
model Attendance {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  note       String?

  @@index([branchId, clockInAt])
  @@index([userId, clockOutAt])
  @@map("attendance")
}

// Delivery zone (Phase 5): matched by customer pincode at order time.
model DeliveryZone {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name           String
  fee            Decimal  @default(0)
  minOrderAmount Decimal  @default(0)
  etaMinutes     Int      @default(45)
  pincodes       Json
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  orders    Order[]

  @@index([branchId, isActive])
  @@map("delivery_zones")
}

// Guest "call waiter" / "ask for bill" from the table QR page (Phase 5).


model TableRequest {
  id       String @id @default(cuid())
  branchId String
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  type       String
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([branchId, resolvedAt])
  @@index([tableId, type, resolvedAt])
  @@map("table_requests")
}

