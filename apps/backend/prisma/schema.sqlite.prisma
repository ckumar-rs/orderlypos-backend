// End-of-day cash count. expectedCash = opening float + cash payments taken
// that day - cash expenses recorded that day; variance = counted - expected.
model CashClosing {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  businessDate DateTime
  openingFloat Decimal  @default(0)
  cashSales    Decimal
  cashExpenses Decimal  @default(0)
  expectedCash Decimal
  countedCash  Decimal
  variance     Decimal
  note         String?

  closedById String
  createdAt  DateTime @default(now())

  @@unique([branchId, businessDate])
  @@map("cash_closings")
}

// A separate cash box from the till. IN adds to the float, OUT spends it.
model PettyCashEntry {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  direction   String
  amount      Decimal
